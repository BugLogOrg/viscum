# Auth.js（必須）
AUTH_SECRET=
# 本番URL例: https://viscum.vercel.app
AUTH_URL=

# デモログイン（段階Bの仮入口。本番GitHub整備後は false 推奨）
AUTH_DEMO_ENABLED=true

# 任意: GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXT_PUBLIC_AUTH_GITHUB=0

# 任意: 直依頼などトランザクションメール（Resend・ADR-029）
# 送信ドメイン mail.viscum.org を Resend で Verified してから使う
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@mail.viscum.org
# From 表示名は送信時にアカウント名を動的結合（ここには固定しない）
# Auth.js Resend プロバイダは RESEND_API_KEY を参照（AUTH_RESEND_KEY でも可）

# 任意: Neon Postgres（未設定時は端末内 localStorage にシード控え）
DATABASE_URL=

# コメント画像など（Vercel Blob）。未設定時は端末内圧縮デモ
# Vercel Dashboard → Storage → Blob → トークンを BLOB_READ_WRITE_TOKEN に
BLOB_READ_WRITE_TOKEN=

# 段階C: Stripe Checkout（採用時支払い・入金）。Connect 出金は後段
# Dashboard → Developers → API keys（テストモード推奨）
STRIPE_SECRET_KEY=
# Webhook: /api/webhooks/stripe（checkout.session.completed）
STRIPE_WEBHOOK_SECRET=
# 成功／キャンセル戻り先の基準URL（本番は https://viscum.vercel.app）
NEXT_PUBLIC_APP_URL=

# メール Magic Link UI（0 で隠す。サーバ側は RESEND_API_KEY＋DATABASE_URL が必要）
NEXT_PUBLIC_AUTH_MAGIC_LINK=1

# 任意: シード公開時に公式 X (@viscum_org) へ告知
# Developer Portal で App を作り、Read and write + User auth（OAuth 1.0a）の
# API Key/Secret と Access Token/Secret を発行（投稿先アカウントで認可）
# Free プランは投稿制限が厳しい。動かないときは Basic 以上を確認
# X_ANNOUNCE_ENABLED=0 で明示オフ（キーがあっても投稿しない）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# X_ANNOUNCE_ENABLED=1
