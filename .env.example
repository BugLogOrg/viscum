# Auth.js（必須）
AUTH_SECRET=
# 本番URL例: https://viscum.vercel.app
AUTH_URL=

# デモログイン（段階Bの仮入口。本番GitHub整備後は false 推奨）
AUTH_DEMO_ENABLED=true

# 任意: GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXT_PUBLIC_AUTH_GITHUB=0

# 任意: Neon Postgres（未設定時は端末内 localStorage にシード控え）
DATABASE_URL=

# 任意: 直依頼などトランザクションメール（Resend・ADR-029）
# 送信ドメイン mail.viscum.org を Resend で Verified してから使う
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@mail.viscum.org
# From 表示名は送信時にアカウント名を動的結合（ここには固定しない）
